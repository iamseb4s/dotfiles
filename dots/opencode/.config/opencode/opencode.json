{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "default_agent": "plan",
  "mcp": {
    "vscode-diff-mcp": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "{env:HOME}/vscode-diff-mcp/server/src/index.ts"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 600000
  },
  "permission": {
    "*": "ask",
    "vscode-diff-mcp_edit_with_diff": "allow",
    "vscode-diff-mcp_write_with_diff": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "find": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "sed -n": "allow",
      "sed -n *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "file": "allow",
      "file *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "whoami": "allow",
      "whoami *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "which": "allow",
      "which *": "allow",
      "fd": "allow",
      "fd *": "allow",
      "diff": "allow",
      "diff *": "allow",
      "jq": "allow",
      "jq *": "allow",
      "git branch": "allow",
      "git tag": "allow",
      "find": "allow",
      "find *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "valid-bedrock-481122-g9"
      }
    }
  },
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,ctrl+j",
    "input_line_home": "ctrl+home",
    "input_line_end": "ctrl+end",
    "terminal_suspend": "none",
    "input_undo": "ctrl+z",
    "input_redo": "ctrl+shift+z",
    "input_clear": "none"
  },
  "tui": {
    "scroll_speed": 5
  }
}
