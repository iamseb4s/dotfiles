{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "default_agent": "plan",
  "mcp": {
    "vscode-diff-mcp": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "/Users/sebas/vscode-diff-mcp/server/src/index.ts"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 600000
  },
  "permission": {
    "*": "ask",
    "vscode-diff-mcp_edit_with_diff": "allow",
    "vscode-diff-mcp_write_with_diff": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "find": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "git status": "allow",
      "git log*": "allow",
      "git diff*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "valid-bedrock-481122-g9"
      }
    }
  },
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,ctrl+j",
    "input_line_home": "ctrl+home",
    "input_line_end": "ctrl+end",
    "terminal_suspend": "none",
    "input_undo": "ctrl+z",
    "input_redo": "ctrl+shift+z",
    "input_clear": "none"
  },
  "tui": {
    "scroll_speed": 5
  }
}
