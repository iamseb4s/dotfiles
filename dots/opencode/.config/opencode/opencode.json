{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "default_agent": "plan",
  "mcp": {
    "vscode-diff-mcp": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "{env:HOME}/vscode-diff-mcp/server/src/index.ts"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 600000
  },
  "permission": {
    "*": "ask",
    "vscode-diff-mcp_edit_with_diff": "allow",
    "vscode-diff-mcp_write_with_diff": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "find": "allow",
    "task": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "sed -n": "allow",
      "sed -n *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "file": "allow",
      "file *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "whoami": "allow",
      "whoami *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "which": "allow",
      "which *": "allow",
      "fd": "allow",
      "fd *": "allow",
      "diff": "allow",
      "diff *": "allow",
      "jq": "allow",
      "jq *": "allow",
      "cut": "allow",
      "cut *": "allow",
      "fold": "allow",
      "fold *": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch --all": "allow",
      "git branch -r": "allow",
      "git branch --remotes": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch --verbose": "allow",
      "git branch --list": "allow",
      "git branch --show-current": "allow",
      "git tag": "allow",
      "git tag -l": "allow",
      "git tag --list": "allow",
      "git tag -n": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git reflog": "allow",
      "git reflog show": "allow",
      "git reflog show *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git rev-list": "allow",
      "git rev-list *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree": "allow",
      "git ls-tree *": "allow",
      "git ls-remote": "allow",
      "git ls-remote *": "allow",
      "git shortlog": "allow",
      "git shortlog *": "allow",
      "git cat-file": "allow",
      "git cat-file *": "allow",
      "git merge-base": "allow",
      "git merge-base *": "allow",
      "git for-each-ref": "allow",
      "git for-each-ref *": "allow",
      "git name-rev": "allow",
      "git name-rev *": "allow",
      "git cherry": "allow",
      "git cherry *": "allow",
      "git count-objects": "allow",
      "git count-objects *": "allow",
      "git diff-tree": "allow",
      "git diff-tree *": "allow",
      "git diff-index": "allow",
      "git diff-index *": "allow",
      "git verify-commit": "allow",
      "git verify-commit *": "allow",
      "git verify-tag": "allow",
      "git verify-tag *": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",
      "git submodule status": "allow",
      "git submodule status *": "allow",
      "git stash list": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show": "allow",
      "git remote show *": "allow",
      "git config --get": "allow",
      "git config --get *": "allow",
      "git config --list": "allow",
      "git config --get-regexp": "allow",
      "git config --get-regexp *": "allow",
      "git fsck": "allow",
      "find": "allow",
      "find *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "valid-bedrock-481122-g9"
      }
    }
  },
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,ctrl+j",
    "input_line_home": "ctrl+home",
    "input_line_end": "ctrl+end",
    "terminal_suspend": "none",
    "input_undo": "ctrl+z",
    "input_redo": "ctrl+shift+z",
    "input_clear": "none"
  },
  "tui": {
    "scroll_speed": 5
  }
}
